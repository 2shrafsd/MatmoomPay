# Production template. Copy to the server as .env and fill in every empty value.
APP_NAME=MatmoomPay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pay.example.om
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=matmoompay
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=
REDIS_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@pay.example.om
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=

GATEWAY_LIVE_PROCESSOR=unconfigured
GATEWAY_WEBHOOKS_ALLOW_PRIVATE_HOSTS=false
GATEWAY_FEE_RATE_BPS=250
GATEWAY_FEE_FIXED=0

SECURITY_CSP_REPORT_ONLY=false
SECURITY_ADMIN_REQUIRES_2FA=true
