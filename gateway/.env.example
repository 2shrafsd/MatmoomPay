APP_NAME=MatmoomPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# After rotating APP_KEY, list the old keys here (comma separated) so encrypted columns stay readable.
# API key hashes and card fingerprints are derived from APP_KEY: rotating it invalidates existing API keys.
APP_PREVIOUS_KEYS=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "info" or higher in production; debug logs can contain request details.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matmoom_pay
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment gateway
GATEWAY_CURRENCY=SDG
GATEWAY_CURRENCY_DECIMALS=0
GATEWAY_FEE_RATE_BPS=250
GATEWAY_FEE_FIXED=0
GATEWAY_MAX_TOTAL_AMOUNT=50000000
GATEWAY_API_RATE_LIMIT=120
GATEWAY_API_IP_RATE_LIMIT=600
# Smallest payment and smallest fee, in whole pounds.
GATEWAY_MIN_AMOUNT=100
GATEWAY_FEE_MINIMUM=1
# Days captured live payments wait before they can be settled (T+2).
GATEWAY_SETTLEMENT_HOLD_DAYS=2
GATEWAY_WEBHOOK_RETENTION_DAYS=90
# Use an S3-compatible private disk in production when running more than one server.
GATEWAY_DOCUMENTS_DISK=local
GATEWAY_SUPPORT_EMAIL=
# "unconfigured" refuses every live charge until a real acquirer driver is registered.
GATEWAY_LIVE_PROCESSOR=unconfigured
# "direct" keeps the card form on our page; "hosted" sends the payer to the simulated bank page.
GATEWAY_SANDBOX_FLOW=direct
# Only for local development, lets webhooks reach localhost endpoints.
GATEWAY_WEBHOOKS_ALLOW_PRIVATE_HOSTS=false

# Security
SECURITY_CSP_REPORT_ONLY=false
SECURITY_ADMIN_REQUIRES_2FA=true
# Comma separated IPs or CIDR ranges of your load balancer. Never "*".
TRUSTED_PROXIES=
# Production: SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true, APP_DEBUG=false
